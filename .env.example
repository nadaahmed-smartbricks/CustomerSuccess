# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://user:password@localhost:5432/customersuccess?schema=public"

# PostHog (server-side sync — used in v1). From PostHog > Project Settings.
POSTHOG_API_KEY=""
POSTHOG_PROJECT_ID="91184"
POSTHOG_HOST="https://us.posthog.com"

# Set to "true" to also exclude @smart-bricks.com emails from the sync (real outreach).
SYNC_EXCLUDE_INTERNAL_DOMAIN="false"

# Claude API — powers AI call-transcript feedback extraction (v3). From console.anthropic.com.
ANTHROPIC_API_KEY=""
# Optional: override the model (defaults to claude-opus-4-8).
ANTHROPIC_MODEL="claude-opus-4-8"

# Shared secret for the call-transcript webhook (POST /api/webhooks/transcript).
# Set this to a long random string and configure your dialer to send it.
TRANSCRIPT_WEBHOOK_SECRET=""

# Twilio Voice Intelligence adapter (POST /api/webhooks/twilio/transcript).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Optional: exact public base URL Twilio calls, e.g. https://customer-success-zeta.vercel.app
# (used to reconstruct the signed URL; falls back to forwarded headers).
WEBHOOK_PUBLIC_BASE_URL=""

# Click-to-call (dial via Twilio from the app).
TWILIO_FROM_NUMBER=""   # your Twilio number, e.g. +15005550006 (caller ID)
AGENT_PHONE=""          # Justin's mobile in E.164, e.g. +9715xxxxxxxx (verified on trial)
TWILIO_INTELLIGENCE_SERVICE_SID=""  # GAxxxx — the Voice Intelligence service, to auto-create transcripts
